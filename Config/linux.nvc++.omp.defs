# --------------------------------------------
# Compile with nvc compiler (with GPU support)
# OpenMP version
# --------------------------------------------
CC      = nvc++

DIAG_SUPPRESS_FLAGS = \
    --diag_suppress=set_but_not_used \
    --diag_suppress=code_is_unreachable \
    --diag_suppress=initialization_not_reachable \
    --diag_suppress=white_space_inside_splice \
    --diag_suppress=declared_but_not_referenced \
    --diag_suppress=implicit_return_from_non_void_function

CFLAGS  = -std=c++17 -c -mp=gpu -gpu=rdc,mem:managed -Minline=1000 -O3 -g -cudalib=nvtx3 -D_USE_NVTX $(DIAG_SUPPRESS_FLAGS)
#-Minfo=mp,accel 

LDFLAGS = -lm -mp=gpu -gpu=rdc,mem:managed -cudalib=nvtx3 -D_USE_NVTX
#-cudalib=nccl -lnccl

PARALLEL = FALSE
