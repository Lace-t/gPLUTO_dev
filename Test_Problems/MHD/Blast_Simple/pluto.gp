if (!exists('dtype')) {
  dtype = 'flt' # Default data type
}
print '> dtype set to ',dtype

# --------------------------------------- 
# Grid setting                            
# --------------------------------------- 
nx1 = 192
nx2 = 192
nx3 = 1
x1beg = -0.500000; x1end = 0.500000
x2beg = -0.500000; x2end = 0.500000
x3beg = -0.500000; x3end = 0.500000
dx1   = 0.005208
dx2   = 0.005208
dx3   = 1.000000

# --------------------------------------- 
# Variable indices                        
# --------------------------------------- 
if (dtype eq 'flt') {
  rho = 0
  vx1 = 1
  vx2 = 2
  vx3 = 3
  Bx1 = 4
  Bx2 = 5
  Bx3 = 6
  prs = 7
  print '> Var Names: rho  vx1  vx2  vx3  Bx1  Bx2  Bx3  prs  '
}
if (dtype eq 'tab') {
  rho = 3
  vx1 = 4
  vx2 = 5
  vx3 = 6
  Bx1 = 7
  Bx2 = 8
  Bx3 = 9
  prs = 10
  print '> Var Names: rho  vx1  vx2  vx3  Bx1  Bx2  Bx3  prs  '
}
if (!exists('nvar')) {
  nvar = 0
  print '> nvar = ',nvar
}

