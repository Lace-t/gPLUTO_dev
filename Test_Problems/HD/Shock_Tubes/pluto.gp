if (!exists('dtype')) {
  dtype = 'dbl' # Default data type
}
print '> dtype set to ',dtype

# --------------------------------------- 
# Grid setting                            
# --------------------------------------- 
nx1 = 400
nx2 = 1
nx3 = 1
x1beg = 0.000000; x1end = 1.000000
x2beg = 0.000000; x2end = 1.000000
x3beg = 0.000000; x3end = 1.000000
dx1   = 0.002500
dx2   = 1.000000
dx3   = 1.000000

# --------------------------------------- 
# Variable indices                        
# --------------------------------------- 
if (dtype eq 'flt') {
  rho = 0
  vx1 = 1
  vx2 = 2
  vx3 = 3
  prs = 4
  print '> Var Names: rho  vx1  vx2  vx3  prs  '
}
if (dtype eq 'dbl') {
  rho = 0
  vx1 = 1
  vx2 = 2
  vx3 = 3
  prs = 4
  print '> Var Names: rho  vx1  vx2  vx3  prs  '
}
if (dtype eq 'tab') {
  rho = 3
  vx1 = 4
  vx2 = 5
  vx3 = 6
  prs = 7
  print '> Var Names: rho  vx1  vx2  vx3  prs  '
}
if (!exists('nvar')) {
  nvar = 0
  print '> nvar = ',nvar
}

